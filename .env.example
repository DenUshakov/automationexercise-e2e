# Copy to .env and adjust. Every value is optional; empty means "use the default".
# Variables set in the shell or in CI take precedence over this file.

# Application under test. Default: https://automationexercise.com
BASE_URL=https://automationexercise.com

# Test data file, relative to the repository root. Default: test-data/default.json
TEST_DATA_FILE=test-data/default.json

# Parallel workers. Default: Playwright's default locally, 2 in CI.
WORKERS=
